# PostgreSQL (Docker: see docs/operations/docker-setup.md)
DATABASE_URL=postgresql://crypto:crypto@localhost:5432/cryptols
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=crypto
POSTGRES_PASSWORD=crypto
POSTGRES_DB=cryptols

# Binance API Keys - Separate keys for different purposes (recommended)
# Data Collection (Read-only, for liquidations data)
BINANCE_DATA_API_KEY=
BINANCE_DATA_API_SECRET=

# Trading/Order Management (Read + Trade, for order placement)
BINANCE_TRADING_API_KEY=
BINANCE_TRADING_API_SECRET=

# Legacy: Single API key (fallback if separate keys not set)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Binance Testnet (recommended for development)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
